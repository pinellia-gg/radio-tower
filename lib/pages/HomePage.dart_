import 'package:flutter/material.dart';

class HomePage extends StatefulWidget {
  const HomePage({super.key, required this.title});

  // This widget is the home page of your application. It is stateful, meaning
  // that it has a State object (defined below) that contains fields that affect
  // how it looks.

  // This class is the configuration for the state. It holds the values (in this
  // case the title) provided by the parent (in this case the App widget) and
  // used by the build method of the State. Fields in a Widget subclass are
  // always marked "final".

  final String title;

  @override
  State<HomePage> createState() => _HomePageView();
}

class _HomePageView extends State<HomePage> {
  var folderPath = "";
  var clickCount = 0;
  final TextEditingController _controller = TextEditingController();

  @override
  Widget build(BuildContext context) {
    var firstRowChildList = <Widget>[];
    var pathTextField = SizedBox(
      width: 200,
      child: TextField(
        controller: _controller,
        autofillHints: {"输入文件夹路径"},
        onChanged: (text) {
          folderPath = text;
        },
      ),
    );

/*    var pathTextField = TextField(
      controller: _controller,
      autofillHints: {"输入文件夹路径"},
      onChanged: (text) {
        folderPath = text;
      },
    );*/

    firstRowChildList.add(Column(children: [Text("路径")]));
    firstRowChildList.add(
      Column(mainAxisSize: MainAxisSize.min, children: [pathTextField]),
    );
    firstRowChildList.add(
      Column(
        children: [
          ElevatedButton(onPressed: onScanPressed, child: Text("开始扫描")),
        ],
      ),
    );
    var firstRow = Row(
      mainAxisSize: MainAxisSize.min,
      children: firstRowChildList,
    );

    var mainColumn = Column(children: [firstRow]);

    return Scaffold(appBar: null, body: mainColumn, floatingActionButton: null);
  }

  void onScanPressed() {
    _controller.text = "点击次数为${++clickCount}";
  }
}
